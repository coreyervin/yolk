<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>yolk</AssemblyName>
    <RootNamespace>Yolk.Cli</RootNamespace>

    <!-- `dotnet publish -r win-x64` produces one small yolk.exe with no
         runtime to install. Ignored by ordinary builds and tests. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yolk.Core\Yolk.Core.csproj" />
    <ProjectReference Include="..\Yolk.Platform.Windows\Yolk.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Yolk.Cli.Tests" />
  </ItemGroup>

</Project>
