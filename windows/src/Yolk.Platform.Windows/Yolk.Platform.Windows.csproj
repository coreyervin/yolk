<Project Sdk="Microsoft.NET.Sdk">

  <!-- The only project that calls Win32. Targets plain net10.0 rather than
       net10.0-windows so the CLI stays NativeAOT-friendly; the platform
       analyzer still flags any call made without a Windows check. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yolk.Core\Yolk.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Yolk.Core.Tests" />
  </ItemGroup>

</Project>
