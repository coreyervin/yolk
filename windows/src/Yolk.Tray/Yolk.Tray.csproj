<Project Sdk="Microsoft.NET.Sdk">

  <!-- The system tray app: a thin WinForms shell over AppModel. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Not "Yolk": Windows ignores case, so Yolk.exe and the CLI's yolk.exe
         couldn't sit in the same folder. -->
    <AssemblyName>YolkApp</AssemblyName>
    <RootNamespace>Yolk.Tray</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\Yolk.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Yolk.png" LogicalName="Yolk.png" />
    <EmbeddedResource Include="Assets\Yolk.ico" LogicalName="Yolk.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yolk.Application\Yolk.Application.csproj" />
    <ProjectReference Include="..\Yolk.Infrastructure\Yolk.Infrastructure.csproj" />
  </ItemGroup>

</Project>
